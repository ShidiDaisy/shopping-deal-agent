# Copy to .env and fill in. Never commit real credentials.
# Alerting is dry-run by default; set to false only after configuring a channel.
SDA_DRY_RUN=true

# Identify yourself honestly; put a real contact address here.
SDA_USER_AGENT=ShoppingDealAgent/0.1 (+mailto:you@example.com)

# Compliance / politeness
SDA_MIN_REQUEST_INTERVAL_SECONDS=3.0
SDA_ROBOTS_STRICT=true
SDA_MAX_RETRIES=2
SDA_BROWSER_FALLBACK=false

# Telegram (optional)
SDA_TELEGRAM_BOT_TOKEN=
SDA_TELEGRAM_CHAT_ID=

# Email / SMTP (optional)
SDA_SMTP_HOST=
SDA_SMTP_PORT=587
SDA_SMTP_USER=
SDA_SMTP_PASSWORD=
SDA_EMAIL_FROM=
SDA_EMAIL_TO=
